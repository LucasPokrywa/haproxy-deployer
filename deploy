#!/bin/bash

set -e

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<EOF
Usage: $0 [OPTIONS]

Options:
  -b, --benchmark, --bench    Lance uniquement le benchmark
  -e, --example               Ajoute les deux serveurs web d’exemple
  -a, --all                   Ajoute tous les fichiers Compose déclarés
  -d, --destroy               Détruit tous les conteneurs du projet
  -s, --https                 Active HTTPS
  -h, --help                  Affiche cette aide

Exemples:
  $0
      Construit et lance HAProxy.

  $0 -b
      Lance uniquement le benchmark.

  $0 --benchmark
      Lance uniquement le benchmark.

  $0 --example
      Lance HAProxy avec les deux serveurs web d’exemple.

  $0 --all
      Lance HAProxy avec tous les fichiers listés dans compose-files.list.

  $0 --https
      Lance HAProxy avec HTTP et HTTPS.

  $0 --destroy
      Détruit tous les conteneurs du projet.
EOF
}

BENCHMARK=false
EXAMPLE=false
ALL=false
DESTROY=false
HTTPS=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -b|--benchmark|--bench)
            BENCHMARK=true
            shift
            ;;
        -e|--example)
            EXAMPLE=true
            shift
            ;;
        -a|--all)
            ALL=true
            shift
            ;;
        -d|--destroy)
            DESTROY=true
            shift
            ;;
        -s|--https)
            HTTPS=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Erreur : option inconnue '$1'"
            echo
            usage
            exit 1
            ;;
    esac
done

if $DESTROY; then
    ALL=true
fi

COMPOSE_FILES=(
    --project-directory "$SCRIPT_DIR"
    --env-file "$SCRIPT_DIR/.env"
    -f "$SCRIPT_DIR/compose.yaml"
)

add_compose_file() {
    local compose_file="$1"
    local resolved_file
    local existing_file

    if [[ "$compose_file" = /* ]]; then
        resolved_file="$compose_file"
    else
        resolved_file="$SCRIPT_DIR/$compose_file"
    fi

    if [[ ! -f "$resolved_file" ]]; then
        echo "Erreur : fichier Compose introuvable : $resolved_file" >&2
        exit 1
    fi

    for existing_file in "${COMPOSE_FILES[@]}"; do
        if [[ "$existing_file" == "$resolved_file" ]]; then
            return
        fi
    done

    COMPOSE_FILES+=(
        -f "$resolved_file"
    )
}

if $EXAMPLE; then
    add_compose_file "examples/two-webservers/docker-compose.yaml"
fi

if $ALL; then
    COMPOSE_LIST_FILE="$SCRIPT_DIR/compose-files.list"

    if [[ ! -f "$COMPOSE_LIST_FILE" ]]; then
        echo "Erreur : liste de fichiers Compose introuvable : $COMPOSE_LIST_FILE" >&2
        exit 1
    fi

    while IFS= read -r compose_file || [[ -n "$compose_file" ]]; do
        compose_file="${compose_file%$'\r'}"

        if [[ -z "$compose_file" || "$compose_file" == \#* ]]; then
            continue
        fi

        add_compose_file "$compose_file"
    done < "$COMPOSE_LIST_FILE"
fi

if $HTTPS; then
    add_compose_file "compose.https.yaml"
fi

if $DESTROY; then
    echo ">> Destruction de tous les conteneurs du projet..."

    docker compose "${COMPOSE_FILES[@]}" \
        --profile benchmark \
        down --remove-orphans

    exit 0
fi

if $BENCHMARK; then
    echo ">> Lancement du benchmark..."

    docker compose "${COMPOSE_FILES[@]}" \
        up -d --build

    docker compose "${COMPOSE_FILES[@]}" \
        --profile benchmark \
        build benchmark

    docker compose "${COMPOSE_FILES[@]}" \
        --profile benchmark \
        run --rm --no-deps benchmark
else
    echo ">> Construction et lancement de HAProxy..."

    docker compose "${COMPOSE_FILES[@]}" \
        up -d --build
fi
